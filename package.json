{
  "name": "mcp-twake-dav",
  "version": "3.1.0",
  "description": "MCP server for Twake.ai Calendar and contacts: give any MCP-compatible AI assistant secure access to your sovereign CalDAV calendars and CardDAV address books",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-twake-dav": "build/index.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "caldav",
    "carddav",
    "calendar",
    "contacts",
    "twake",
    "twake.ai",
    "linagora",
    "ai",
    "sovereign",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/mcp-twake-dav.git"
  },
  "homepage": "https://github.com/linagora/mcp-twake-dav#readme",
  "bugs": {
    "url": "https://github.com/linagora/mcp-twake-dav/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chrono-node": "^2.9.0",
    "ical.js": "^2.2.1",
    "pino": "^10.3.0",
    "tsdav": "^2.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "LINAGORA <https://linagora.com>"
}
